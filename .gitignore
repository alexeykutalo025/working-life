# Runtime working directory — the archive database, blobs, logs and exports.
# Never committed: it contains the user's mail.
workdir/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Test fixtures are generated on demand, never committed:
#   real/      user-supplied PST/OST, which are someone's actual mail
#   generated* written by tests/fixtures/generate.py
tests/fixtures/real/
tests/fixtures/generated*/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.claude/launch.json
